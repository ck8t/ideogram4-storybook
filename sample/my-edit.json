        "temperature": 0.8,
        "_portTypes": {
          "in_input": "any",
          "out_data": "string"
        }
      },
      "n_937c9015-1ecf-4ae1-b178-4fd1295c527b": {
        "split_by": "scene",
        "include_heading": false,
        "max_scenes": "8",
        "_portTypes": {
          "in_input": "any",
          "out_scenes": "array",
          "out_first": "json",
          "out_last": "json",
          "out_count": "number"
        }
      },
      "n_e4cdebbe-4b2d-4a37-a0ef-4d395d621096": {
        "language": "javascript",
        "code": "return (async () => {\n  // Paste your RunPod proxy URL here (same one as the Load Model block below).\n  var RUNPOD_URL = 'RUNPOD_URL';\n  var serverUrl = String(RUNPOD_URL || '').replace(/\\/$/, '');\n\n  var scenes = Array.isArray(input) ? input : (input && Array.isArray(input.scenes) ? input.scenes : []);\n  var images = [];\n\n  for (var i = 0; i < scenes.length; i++) {\n    var scene = scenes[i] || {};\n    var prompt = String(scene.content || scene.title || '').slice(0, 900);\n    if (!prompt || !serverUrl || serverUrl === 'RUNPOD_URL') { images.push(null); continue; }\n    try {\n      var resp = await fetch(serverUrl + '/generate', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({\n          prompt: prompt,\n          preset: 'DEFAULT',\n          aspect_ratio: '4:3',\n          magic: true,\n          return_base64: true,\n        }),\n      });\n      if (!resp.ok) {\n        console.warn('Scene ' + (i + 1) + ' generate failed: HTTP ' + resp.status);\n        images.push(null);\n        continue;\n      }\n      var data = await resp.json();\n      images.push(data.image_b64 || null);\n    } catch (e) {\n      console.warn('Scene ' + (i + 1) + ' generate error: ' + (e && e.message));\n      images.push(null);\n    }\n  }\n\n  return images;\n})();",
        "_portTypes": {
          "in_input": "array",
          "out_result": "array"
        }
      },
