{
  "_comment": "Ideogram 4.0 API flow. Pipeline: user types prompt → API call to /v1/ideogram-v4/generate → image_url_preview shows the image → image_url_to_base64 downloads it → storybook_pdf embeds it as cover → show_preview renders the PDF. Auth: set authApiKeyValue in n_ideogram_api. Content-Type: multipart/form-data is handled by the api block's Body Type dropdown — no manual Content-Type header needed.",
  "workflow": {
    "id": "wf_ideogram_api_storybook_sample",
    "name": "Ideogram 4.0 — Simple Prompt → Preview → PDF",
    "teamId": "t_fullstack",
