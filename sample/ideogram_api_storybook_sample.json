      {
        "id": "n_starter",
        "data": { "title": "Start", "bgColor": "#2FB67C", "blockType": "starter" },
        "type": "builderBlock",
        "position": { "x": -900, "y": 250 }
      },
      {
        "id": "n_prompt_input",
        "data": { "title": "Image Prompt", "bgColor": "#FBBF24", "blockType": "user_input" },
        "type": "builderBlock",
        "position": { "x": -600, "y": 250 }
      },
      {
        "id": "n_ideogram_api",
        "data": { "title": "Generate Image (Ideogram 4.0)", "bgColor": "#2F55FF", "blockType": "api" },
        "type": "builderBlock",
        "position": { "x": -230, "y": 250 }
      },
      {
        "id": "n_image_preview",
        "data": { "title": "Image Preview", "bgColor": "#8B5CF6", "blockType": "image_url_preview" },
        "type": "builderBlock",
        "position": { "x": 200, "y": 0 }
      },
      {
        "id": "n_image_to_base64",
        "data": { "title": "Image → Base64", "bgColor": "#6366F1", "blockType": "image_url_to_base64" },
